#!/bin/sh

##############################################################################
#
#   Gradle start up script script for POSIX generated by Gradle.
#
##############################################################################

# Resolve links: $0 may be a link
app_path=$0
# Need this for daisy-chained symlinks.
while
    APP_HOME=${app_path%"$(basename "$app_path")"}  # leaves a trailing /; empty if no leading path
    [ -h "$app_path" ]
do
    ls=$( ls -ld "$app_path" )
    link=${ls#*' -> '}
    case $link in             #(
      /*)   app_path=$link ;; #(
      *)    app_path=$APP_HOME$link ;;
    esac
done

# This is normally unused
#shellcheck disable=SC2034
APP_BASE_NAME=${0##*/}
#shellcheck disable=SC2034
APP_HOME=$( cd "${APP_HOME:-./}" > /dev/null && pwd -P )

# Use the maximum available, or set MAX_FD != -1 to use that, on Cygwin NT and
# MSYS2.
MAX_FD=maximum

# Function isatty
isatty() { [ -t 1 ] || [ -t 2 ] || [ -t 4 ] || return 1 ; }

# On with the show
warn () { echo "$*"; } >&2
die () { echo; echo "$*"; echo; exit 1; } >&2

# OS specific support
cygwin=false
msys=false
darwin=false
nonstop=false
case "$(uname)" in
  CYGWIN* )         cygwin=true ;; #(
  Darwin* )         darwin=true ;; #(
  MSYS* | MINGW* )  msys=true ;;
  NonStop* )        nonstop=true ;;
esac

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME"
    fi
else
    JAVACMD=java
    if ! command -v java >/dev/null 2>&1
    then
        die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH."
    fi
fi

# For Cygwin or MSYS, switch paths to Windows format
if $cygwin || $msys ; then
    APP_HOME=$( cygpath --path --mixed "$APP_HOME" )
    CLASSPATH=$( cygpath --path --mixed "$CLASSPATH" )
fi

# Collect all arguments
eval set -- $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS "\"-Dorg.gradle.appname=${APP_BASE_NAME}\"" -classpath "\"$CLASSPATH\"" org.gradle.wrapper.GradleWrapperMain "$APP_ARGS" "$@"

exec "$JAVACMD" "$@"
