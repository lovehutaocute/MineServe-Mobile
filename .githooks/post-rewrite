#!/bin/sh
# Rewritten commits must refresh the same local bare mirror.
mirror="C:/Users/DELL/Desktop/AI/VSCode2/MCServerManager.git-backup"
source="C:/Users/DELL/Desktop/AI/VSCode2/MCServerManager/.git"
log="$source/git-backup.log"

if git --git-dir="$mirror" fetch --quiet "$source" \
  '+refs/heads/*:refs/heads/*' '+refs/tags/*:refs/tags/*'; then
  printf '%s post-rewrite backup succeeded\n' "$(date -Iseconds)" >> "$log"
else
  printf '%s post-rewrite backup failed\n' "$(date -Iseconds)" >> "$log"
fi

exit 0
